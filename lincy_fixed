#!/usr/bin/env bash
# ==============================================================================
# Lincy - Native CLI VPN Client for Arch Linux & Linux systems
# Virtual TUN Interface: lincytun0 | Core: sing-box | Subscriptions: RAW / JSON
# ==============================================================================

set -e

# --- Configuration Paths ---
VERSION="1.0.0"
CONFIG_DIR="/etc/lincy"
STATE_FILE="${CONFIG_DIR}/state.json"
SERVERS_FILE="${CONFIG_DIR}/servers.json"
RUNTIME_CONFIG="${CONFIG_DIR}/config.json"
SERVICE_FILE="/etc/systemd/system/lincy.service"
BIN_TARGET="/usr/local/bin/lincy"
ALT_BIN_TARGET="/usr/bin/lincy"
TUN_INTERFACE="lincytun0"
ARCH=$(uname -m)
DEFAULT_UA="Lincy/${VERSION} (Arch Linux; Linux ${ARCH})"

# --- Colors ---
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_CYAN="\033[96m"
C_GREEN="\033[92m"
C_YELLOW="\033[93m"
C_RED="\033[91m"
C_BLUE="\033[94m"
C_DIM="\033[2m"

# --- Helper Functions ---
log_info() { echo -e "${C_BLUE}[INFO]${C_RESET} $1"; }
log_ok()   { echo -e "${C_GREEN}[✓]${C_RESET} $1"; }
log_warn() { echo -e "${C_YELLOW}[WARN]${C_RESET} $1"; }
log_err()  { echo -e "${C_RED}[ERROR]${C_RESET} $1" >&2; }

require_root() {
    if [[ $EUID -ne 0 ]]; then
        log_err "Эту команду необходимо запускать с правами root: sudo lincy <команда>"
        exit 1
    fi
}

# --- Distro & Device Information ---
get_distro_name() {
    if [[ -f /etc/os-release ]]; then
        local pretty=$(grep -E '^PRETTY_NAME=' /etc/os-release | cut -d= -f2- | tr -d '"' | tr -d '\r\n')
        if [[ -n "$pretty" ]]; then
            echo "$pretty"
            return
        fi
        local name=$(grep -E '^NAME=' /etc/os-release | cut -d= -f2- | tr -d '"' | tr -d '\r\n')
        if [[ -n "$name" ]]; then
            echo "$name"
            return
        fi
    fi
    echo "Linux"
}

get_device_model() {
    local model=""
    if [[ -f /sys/class/dmi/id/product_name ]]; then
        model=$(cat /sys/class/dmi/id/product_name 2>/dev/null | tr -d '\r\n')
    fi
    if [[ -z "$model" || "$model" == "System Product Name" || "$model" == "None" || "$model" == "To be filled by O.E.M." ]]; then
        if [[ -f /sys/class/dmi/id/board_name ]]; then
            model=$(cat /sys/class/dmi/id/board_name 2>/dev/null | tr -d '\r\n')
        fi
    fi
    local host=$(hostname 2>/dev/null || uname -n)
    if [[ -n "$model" && "$model" != "System Product Name" && "$model" != "None" && "$model" != "To be filled by O.E.M." ]]; then
        echo "${model} (${host})"
    else
        echo "${host}"
    fi
}

get_user_agent() {
    local distro=$(get_distro_name)
    local device=$(get_device_model)
    local arch=$(uname -m)
    echo "Lincy/${VERSION} (${distro}; ${device}; Linux ${arch})"
}

# --- Hardware ID (HWID) Generator ---
get_hwid() {
    local seed=""
    if [[ -f /etc/machine-id ]]; then
        seed+=$(cat /etc/machine-id 2>/dev/null | tr -d '\r\n')
    elif [[ -f /var/lib/dbus/machine-id ]]; then
        seed+=$(cat /var/lib/dbus/machine-id 2>/dev/null | tr -d '\r\n')
    fi
    if [[ -f /sys/class/dmi/id/product_uuid ]]; then
        seed+=":"$(cat /sys/class/dmi/id/product_uuid 2>/dev/null | tr -d '\r\n')
    fi
    for mac_file in /sys/class/net/*/address; do
        if [[ "$mac_file" != *"/lo/"* && -f "$mac_file" ]]; then
            local mac=$(cat "$mac_file" 2>/dev/null | tr -d '\r\n')
            if [[ -n "$mac" && "$mac" != "00:00:00:00:00:00" ]]; then
                seed+=":${mac}"
                break
            fi
        fi
    done
    if [[ -z "$seed" ]]; then
        seed="arch-linux-seed-$(uname -n)"
    fi
    seed+=":lincy-linux-hwid"
    echo -n "$seed" | sha256sum | awk '{print $1}'
}

# --- State Management ---
init_dirs() {
    mkdir -p "${CONFIG_DIR}"
    chmod 755 "${CONFIG_DIR}"
}

get_state_val() {
    local key="$1"
    local default_val="$2"
    if [[ -f "${STATE_FILE}" ]]; then
        local val=$(jq -r ".${key} // empty" "${STATE_FILE}" 2>/dev/null)
        if [[ -n "$val" ]]; then
            echo "$val"
            return
        fi
    fi
    echo "$default_val"
}

set_state_val() {
    local key="$1"
    local val="$2"
    init_dirs
    if [[ ! -f "${STATE_FILE}" ]]; then
        echo "{}" > "${STATE_FILE}"
    fi
    local tmp=$(mktemp)
    jq --arg k "$key" --arg v "$val" '.[$k] = $v' "${STATE_FILE}" > "$tmp" && mv "$tmp" "${STATE_FILE}"
    chmod 644 "${STATE_FILE}" 2>/dev/null || true
}

# --- Sing-box Config Generator in Pure jq ---
# --- Определяем, доступен ли IPv6 в системе ---
host_has_ipv6() {
    [[ -d /proc/sys/net/ipv6 ]] || return 1
    local dis
    dis=$(cat /proc/sys/net/ipv6/conf/all/disable_ipv6 2>/dev/null || echo 1)
    [[ "$dis" == "0" ]] || return 1
    ip -6 addr show scope global 2>/dev/null | grep -q "inet6" || return 1
    return 0
}

# --- Detect local (upstream) DNS server for direct queries ---
detect_direct_dns() {
    local dns=""
    if [[ -f /etc/resolv.conf ]]; then
        dns=$(grep -E '^[[:space:]]*nameserver' /etc/resolv.conf 2>/dev/null \
              | awk '{print $2}' \
              | grep -vE '^(127\.|::1|0\.0\.0\.0)' \
              | head -n 1)
    fi
    # Если в resolv.conf только локальный заглушечный DNS или роутер из серой сети
    # (роутеры долго кэшируют старые IP серверов), используем надёжный прямой DNS:
    if [[ -z "$dns" || "$dns" =~ ^(192\.168\.|10\.|172\.(1[6-9]|2[0-9]|3[01])\.) ]]; then
        dns="77.88.8.8"
    fi
    echo "$dns"
}

# --- Sing-box version helpers ---
singbox_bin_path() {
    command -v sing-box 2>/dev/null || echo "/usr/local/bin/sing-box"
}

singbox_version() {
    local bin
    bin=$(singbox_bin_path)
    [[ -x "$bin" ]] || { echo "0.0.0"; return; }
    "$bin" version 2>/dev/null | head -n 1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n 1 || echo "0.0.0"
}

# Возвращает 0, если ядро старое (< 1.12) и требует legacy-синтаксиса конфига
singbox_is_legacy() {
    local v
    v=$(singbox_version)
    [[ "$v" == "0.0.0" ]] && return 1
    local lowest
    lowest=$(printf '%s\n%s\n' "$v" "1.12.0" | sort -V | head -n 1)
    [[ "$lowest" == "$v" && "$v" != "1.12.0" ]]
}

# --- Sing-box Config Generator in Pure jq ---
generate_config() {
    local server_json="$1"
    init_dirs

    # Удаляем старый конфиг перед созданием нового
    rm -f "${RUNTIME_CONFIG}"

    local stack
    stack=$(get_state_val "tun_stack" "gvisor")
    local direct_dns
    direct_dns=$(detect_direct_dns)

    local has_ipv6="false"
    if host_has_ipv6; then
        has_ipv6="true"
    else
        log_warn "IPv6 отключён в системе — туннель поднимается только с IPv4."
    fi

    local tmp_cfg
    tmp_cfg=$(mktemp)

    if ! python3 - "$stack" "$direct_dns" "${TUN_INTERFACE}" "$has_ipv6" "${CONFIG_DIR}" > "$tmp_cfg" << 'PYEOF'
import sys, json, os

stack = sys.argv[1]
direct_dns = sys.argv[2]
tun_name = sys.argv[3]
has_ipv6 = (sys.argv[4].lower() == "true")
config_dir = sys.argv[5]

server_data = sys.stdin.read()
s = json.loads(server_data) if server_data.strip() else {}

ob = None
if s.get('raw_json'):
    outbounds = s['raw_json'].get('outbounds', [])
    for o in outbounds:
        if o.get('tag') in ('proxy', 'default'):
            ob = o
            break
    if not ob and outbounds:
        ob = outbounds[0]

ss = ob.get('streamSettings', {}) if ob else {}
net = ss.get('network') if ss else s.get('network', 'tcp')
if not net: net = 'tcp'
sec = ss.get('security') if ss else s.get('security', 'none')
if not sec: sec = 'none'

if ob:
    settings = ob.get('settings', {})
    vnext = settings.get('vnext', [{}])[0]
    host = settings.get('address') or vnext.get('address') or s.get('server', '')
    port = int(settings.get('port') or vnext.get('port') or s.get('server_port', 443))
    users = vnext.get('users', [{}])[0]
    uuid = settings.get('id') or users.get('id') or s.get('uuid', '')
    flow_raw = settings.get('flow') or users.get('flow') or s.get('flow', '')
else:
    host = s.get('server', '')
    port = int(s.get('server_port', 443))
    uuid = s.get('uuid', '')
    flow_raw = s.get('flow', '')

flow = flow_raw if net == 'tcp' else ''

reality_settings = ss.get('realitySettings', {}) if ss else {}
tls_settings = ss.get('tlsSettings', {}) if ss else {}
sni = reality_settings.get('serverName') or (reality_settings.get('serverNames') or [''])[0] or tls_settings.get('serverName') or s.get('sni', '')
fp = reality_settings.get('fingerprint') or tls_settings.get('fingerprint') or s.get('fp', 'firefox')
pbk = reality_settings.get('publicKey') or s.get('pbk', '')
sid = reality_settings.get('shortId') or (reality_settings.get('shortIds') or [''])[0] or s.get('sid', '')
grpc_name = ss.get('grpcSettings', {}).get('serviceName') or s.get('service_name', '')
ws_path = ss.get('wsSettings', {}).get('path') or s.get('ws_path', '/')
ws_headers = ss.get('wsSettings', {}).get('headers', {}) if ss else ({'Host': s['ws_host']} if s.get('ws_host') else {})

transport_type = 'httpupgrade' if net in ('xhttp', 'httpupgrade') else net

proxy = {
    'type': 'vless',
    'tag': 'proxy',
    'server': host or '127.0.0.1',
    'server_port': port,
    'uuid': uuid or '00000000-0000-0000-0000-000000000000',
    'packet_encoding': 'xudp',
    'domain_resolver': 'direct-dns'
}
if flow:
    proxy['flow'] = flow
if sec in ('reality', 'tls'):
    tls_cfg = {
        'enabled': True,
        'server_name': sni or 'www.mozilla.org',
        'utls': {'enabled': True, 'fingerprint': fp or 'firefox'}
    }
    if sec == 'reality' and pbk:
        r_cfg = {'enabled': True, 'public_key': pbk}
        if sid: r_cfg['short_id'] = sid
        tls_cfg['reality'] = r_cfg
    proxy['tls'] = tls_cfg

if net == 'ws':
    proxy['transport'] = {'type': 'ws', 'path': ws_path, 'headers': ws_headers}
elif transport_type in ('httpupgrade', 'http'):
    proxy['transport'] = {'type': transport_type, 'path': ws_path}
elif net == 'grpc':
    proxy['transport'] = {'type': 'grpc', 'service_name': grpc_name}

# Direct sites & VK Music domains
direct_suffixes = set()
rpath = os.path.join(config_dir, 'routing.json')
if os.path.exists(rpath):
    try:
        with open(rpath) as rf:
            rdata = json.load(rf)
            for item in rdata.get('DirectSites', []):
                if item.startswith('domain:'):
                    d = item[7:].strip()
                    if d: direct_suffixes.add(d)
    except Exception:
        pass

vk_domains = [
    'vk.com', 'vk.me', 'vkuser.net', 'vkuseraudio.net', 'vk-cdn.me', 'vkcdn.ru',
    'vk-portal.net', 'vkuservideo.net', 'vkplay.ru', 'vk.link', 'userapi.com',
    'mycdn.me', 'ok.ru', 'odnoklassniki.ru', 'mail.ru', 'imgsmail.ru'
]
for d in vk_domains: direct_suffixes.add(d)
for tld in ['.ru', '.xn--p1ai', '.su', '.by', '.kz']: direct_suffixes.add(tld)

# Kill Switch: domains that MUST go to proxy and NEVER leak to direct
google_killswitch_domains = [
    'google.com', 'googleapis.com', 'gstatic.com', 'googleusercontent.com', 'ggpht.com',
    'youtube.com', 'googlevideo.com', 'youtu.be', 'ytimg.com',
    'openai.com', 'chatgpt.com', 'oaistatic.com', 'oaiusercontent.com',
    'anthropic.com', 'claude.ai',
    'antigravity.google', 'gemini.google.com'
]

# VK CDN & media IP CIDRs
vk_cidrs = [
    '87.240.128.0/18', '93.186.224.0/20', '95.142.192.0/20',
    '95.213.0.0/18', '185.32.248.0/22', '185.89.12.0/22'
]

cfg = {
    'log': {'level': 'warn', 'timestamp': True},
    'dns': {
        'servers': [
            {'tag': 'remote-dns', 'type': 'udp', 'server': '1.1.1.1', 'server_port': 53, 'detour': 'proxy'},
            {'tag': 'direct-dns', 'type': 'udp', 'server': direct_dns, 'server_port': 53, 'detour': 'direct'}
        ],
        'rules': [
            {'domain_suffix': sorted(list(direct_suffixes)), 'server': 'direct-dns'},
            {'domain_suffix': google_killswitch_domains, 'server': 'remote-dns'}
        ],
        'strategy': 'ipv4_only',
        'independent_cache': True,
        'final': 'remote-dns'
    },
    'inbounds': [
        {
            'type': 'tun',
            'tag': 'tun-in',
            'interface_name': tun_name,
            'address': ['172.19.0.1/30', 'fdfe:dcba:9876::1/126'] if has_ipv6 else ['172.19.0.1/30'],
            'mtu': 1420,
            'auto_route': True,
            'strict_route': True,
            'stack': stack
        }
    ],
    'outbounds': [
        proxy,
        {'type': 'direct', 'tag': 'direct', 'domain_resolver': 'direct-dns'},
        {'type': 'block', 'tag': 'block'}
    ],
    'route': {
        'default_domain_resolver': 'direct-dns',
        'rules': [
            {'action': 'sniff'},
            {'protocol': 'dns', 'action': 'hijack-dns'},
            {'port': 53, 'action': 'hijack-dns'},
            {'ip_is_private': True, 'outbound': 'direct'},
            # Killswitch rule 1: strictly proxy Google / AI traffic
            {'domain_suffix': google_killswitch_domains, 'outbound': 'proxy'},
            # Direct routing: VK, Russian domains & VK IP ranges
            {'domain_suffix': sorted(list(direct_suffixes)), 'outbound': 'direct'},
            {'ip_cidr': vk_cidrs, 'outbound': 'direct'},
            # Killswitch rule 2: block any Google / AI traffic from leaking
            {'domain_suffix': google_killswitch_domains, 'outbound': 'block'}
        ],
        'final': 'proxy',
        'auto_detect_interface': True
    }
}

print(json.dumps(cfg, indent=2))
PYEOF
    then
        rm -f "$tmp_cfg"
        log_err "Не удалось сформировать конфигурацию sing-box (проверьте данные сервера)."
        return 1
    fi <<< "$server_json"

    if [[ ! -s "$tmp_cfg" ]]; then
        rm -f "$tmp_cfg"
        log_err "Конфигурация sing-box оказалась пустой."
        return 1
    fi

    mv -f "$tmp_cfg" "${RUNTIME_CONFIG}"
    chmod 600 "${RUNTIME_CONFIG}"

    # Валидация конфига ядром до запуска службы
    local bin
    bin=$(singbox_bin_path)
    if [[ -x "$bin" ]]; then
        local check_out
        if ! check_out=$("$bin" check -c "${RUNTIME_CONFIG}" 2>&1); then
            log_err "Ядро sing-box отвергло конфигурацию:"
            echo -e "${C_DIM}${check_out}${C_RESET}"
            return 1
        fi
    fi
    return 0
}

# --- Service Unit Generator ---
ensure_systemd_service() {
    local singbox_bin modprobe_bin
    singbox_bin=$(singbox_bin_path)
    modprobe_bin=$(command -v modprobe 2>/dev/null || echo "/usr/bin/modprobe")
    cat <<EOF > "${SERVICE_FILE}"
[Unit]
Description=Lincy VPN Tunnel Service (${TUN_INTERFACE})
After=network.target network-online.target nss-lookup.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=${CONFIG_DIR}
Environment="ENABLE_DEPRECATED_LEGACY_DNS_SERVERS=true"
Environment="ENABLE_DEPRECATED_SPECIAL_OUTBOUNDS=true"
Environment="ENABLE_DEPRECATED_TUN_ADDRESS_X=true"
Environment="ENABLE_DEPRECATED_INBOUND_FIELDS=true"
Environment="ENABLE_DEPRECATED_DIRECT_DIAL_FIELDS=true"
Environment="ENABLE_DEPRECATED_MISSING_DOMAIN_RESOLVER=true"
ExecStartPre=-${modprobe_bin} tun
ExecStartPre=${singbox_bin} check -c ${RUNTIME_CONFIG}
ExecStart=${singbox_bin} run -c ${RUNTIME_CONFIG}
Restart=on-failure
RestartSec=3s
LimitNOFILE=65535
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_ADMIN
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
EOF
    systemctl daemon-reload
}

# --- Network adapter detection & repair ---
list_physical_ifaces() {
    local i
    for i in /sys/class/net/*; do
        i=$(basename "$i")
        case "$i" in
            lo|"${TUN_INTERFACE}"|docker*|br-*|veth*|virbr*|tun*|tap*|wg*|zt*) continue ;;
        esac
        echo "$i"
    done
}

iface_is_up() {
    local i="$1"
    [[ -r "/sys/class/net/${i}/operstate" ]] || return 1
    local st
    st=$(cat "/sys/class/net/${i}/operstate" 2>/dev/null)
    [[ "$st" == "up" || "$st" == "unknown" ]] && ip link show "$i" 2>/dev/null | head -n 1 | grep -q "state UP\|,UP"
}

iface_has_ip() {
    ip -4 addr show dev "$1" scope global 2>/dev/null | grep -q "inet "
}

# Возвращает имя основного физического интерфейса (или пусто)
detect_uplink_iface() {
    local i
    for i in $(list_physical_ifaces); do
        if iface_is_up "$i" && iface_has_ip "$i"; then
            echo "$i"
            return 0
        fi
    done
    for i in $(list_physical_ifaces); do
        if iface_is_up "$i"; then
            echo "$i"
            return 0
        fi
    done
    return 1
}

try_repair_iface() {
    local i="$1"
    log_warn "Интерфейс ${C_BOLD}${i}${C_RESET} находится в состоянии DOWN. Пробую поднять..."

    if command -v rfkill &>/dev/null; then
        rfkill unblock all 2>/dev/null || true
    fi

    ip link set dev "$i" up 2>/dev/null || true
    sleep 1

    if ! iface_is_up "$i"; then
        if command -v nmcli &>/dev/null && systemctl is-active --quiet NetworkManager 2>/dev/null; then
            log_info "Пробую поднять через NetworkManager..."
            nmcli device connect "$i" &>/dev/null || nmcli device set "$i" managed yes &>/dev/null || true
            sleep 2
        elif command -v networkctl &>/dev/null && systemctl is-active --quiet systemd-networkd 2>/dev/null; then
            log_info "Пробую поднять через systemd-networkd..."
            networkctl up "$i" &>/dev/null || true
            systemctl restart systemd-networkd &>/dev/null || true
            sleep 2
        fi
    fi

    # Ждём получения адреса (DHCP)
    local t=0
    while (( t < 12 )); do
        if iface_is_up "$i" && iface_has_ip "$i"; then
            log_ok "Интерфейс ${i} поднят, адрес получен: $(ip -4 -o addr show dev "$i" scope global | awk '{print $4}' | head -n1)"
            return 0
        fi
        sleep 1
        t=$((t + 1))
    done

    if iface_is_up "$i" && ! iface_has_ip "$i"; then
        log_warn "Интерфейс ${i} поднят, но не получил IP-адрес."
        if command -v dhcpcd &>/dev/null; then
            log_info "Запрашиваю адрес через dhcpcd..."
            dhcpcd -n "$i" &>/dev/null || dhcpcd "$i" &>/dev/null || true
            sleep 3
        elif command -v dhclient &>/dev/null; then
            log_info "Запрашиваю адрес через dhclient..."
            dhclient "$i" &>/dev/null || true
            sleep 3
        fi
        iface_has_ip "$i" && { log_ok "Адрес получен."; return 0; }
    fi

    return 1
}

# Полная проверка физической сети. 0 — всё ок, 1 — сети нет
check_network_adapter() {
    local quiet="${1:-0}"
    local ifaces
    ifaces=$(list_physical_ifaces)

    if [[ -z "$ifaces" ]]; then
        log_err "В системе не найдено ни одного физического сетевого адаптера."
        return 1
    fi

    local up_iface=""
    up_iface=$(detect_uplink_iface || true)

    if [[ -z "$up_iface" ]]; then
        log_err "Все сетевые адаптеры выключены (DOWN):"
        local i
        for i in $ifaces; do
            echo -e "    ${C_DIM}- ${i}: $(cat "/sys/class/net/${i}/operstate" 2>/dev/null || echo unknown)${C_RESET}"
        done
        for i in $ifaces; do
            if try_repair_iface "$i"; then
                up_iface="$i"
                break
            fi
        done
        if [[ -z "$up_iface" ]]; then
            log_err "Не удалось автоматически восстановить сетевое подключение."
            log_err "Проверьте вручную: ip link | nmcli device status | systemctl status NetworkManager"
            return 1
        fi
    elif ! iface_has_ip "$up_iface"; then
        log_warn "Интерфейс ${up_iface} поднят, но без IPv4-адреса."
        try_repair_iface "$up_iface" || {
            log_err "Интерфейс ${up_iface} так и не получил IP-адрес."
            return 1
        }
    fi

    # Проверяем наличие маршрута по умолчанию мимо туннеля
    local def_route
    def_route=$(ip route show default 2>/dev/null | grep -v "${TUN_INTERFACE}" | head -n 1)
    if [[ -z "$def_route" ]]; then
        log_warn "Отсутствует маршрут по умолчанию для физического интерфейса ${up_iface}."
        local gw
        gw=$(ip -4 route show dev "$up_iface" 2>/dev/null | awk '/proto/ {print $1}' | head -n 1)
        if command -v nmcli &>/dev/null; then
            nmcli device reapply "$up_iface" &>/dev/null || true
            sleep 2
        fi
        def_route=$(ip route show default 2>/dev/null | grep -v "${TUN_INTERFACE}" | head -n 1)
        [[ -z "$def_route" ]] && log_warn "Маршрут по умолчанию не восстановлен — туннель может не подняться."
    fi

    if [[ "$quiet" != "1" ]]; then
        log_ok "Сетевой адаптер: ${C_BOLD}${up_iface}${C_RESET} ($(ip -4 -o addr show dev "$up_iface" scope global 2>/dev/null | awk '{print $4}' | head -n1 || echo "без IP"))"
    fi

    set_state_val "uplink_iface" "$up_iface"
    return 0
}

# --- TUN device prerequisites ---
ensure_tun_device() {
    if [[ ! -c /dev/net/tun ]]; then
        log_warn "Устройство /dev/net/tun отсутствует. Загружаю модуль ядра tun..."
        modprobe tun 2>/dev/null || true
        sleep 1
    fi
    if [[ ! -c /dev/net/tun ]]; then
        mkdir -p /dev/net
        mknod /dev/net/tun c 10 200 2>/dev/null || true
        chmod 600 /dev/net/tun 2>/dev/null || true
    fi
    if [[ ! -c /dev/net/tun ]]; then
        log_err "Ядро не предоставляет /dev/net/tun. Туннель невозможен без поддержки TUN."
        return 1
    fi

    if ! command -v nft &>/dev/null && ! command -v iptables &>/dev/null; then
        log_warn "Не найдены nftables/iptables — автоматическая маршрутизация может не работать."
        log_warn "Установите: sudo pacman -S nftables"
    fi
    return 0
}

# --- Wait until the TUN interface is really up ---
wait_tun_up() {
    local timeout="${1:-15}"
    local t=0
    while (( t < timeout )); do
        if ip link show "${TUN_INTERFACE}" &>/dev/null; then
            if ip link show "${TUN_INTERFACE}" | head -n 1 | grep -q "UP"; then
                if ip route show table all 2>/dev/null | grep -q "${TUN_INTERFACE}"; then
                    return 0
                fi
            fi
        fi
        systemctl is-active --quiet lincy.service || return 2
        sleep 1
        t=$((t + 1))
    done
    return 1
}

# --- Real traffic verification through the tunnel ---
verify_tunnel_traffic() {
    local ip_out=""
    echo -ne "  ${C_DIM}проверка трафика...${C_RESET}\r" >&2
    ip_out=$(curl -4 -s --connect-timeout 3 --max-time 5 "https://api.ipify.org" 2>/dev/null || echo "")
    ip_out=$(echo "$ip_out" | tr -d '\r\n[:space:]')
    echo -ne "\033[2K\r" >&2

    if [[ "$ip_out" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo "$ip_out"
        return 0
    fi

    # Разделяем: проблема в DNS или в самом туннеле
    if curl -4 -s --max-time 3 -o /dev/null "http://1.1.1.1" 2>/dev/null; then
        log_warn "IP-соединение через туннель есть, но не работает разрешение имён (DNS)."
    fi
    return 1
}

diagnose_tunnel() {
    echo -e "\n${C_BOLD}${C_YELLOW}Диагностика туннеля:${C_RESET}"
    if ! systemctl is-active --quiet lincy.service; then
        echo -e "  ${C_RED}✗${C_RESET} Служба lincy.service не запущена."
    else
        echo -e "  ${C_GREEN}✓${C_RESET} Служба lincy.service активна."
    fi
    if ip link show "${TUN_INTERFACE}" &>/dev/null; then
        echo -e "  ${C_GREEN}✓${C_RESET} Интерфейс ${TUN_INTERFACE} создан."
    else
        echo -e "  ${C_RED}✗${C_RESET} Интерфейс ${TUN_INTERFACE} отсутствует."
    fi
    if ip route show table all 2>/dev/null | grep -q "${TUN_INTERFACE}"; then
        echo -e "  ${C_GREEN}✓${C_RESET} Маршруты через ${TUN_INTERFACE} установлены."
    else
        echo -e "  ${C_RED}✗${C_RESET} Маршруты через ${TUN_INTERFACE} не установлены (auto_route не сработал)."
    fi
    local sel_idx s_json host port
    sel_idx=$(get_state_val "selected_index" "1")
    if [[ -f "${SERVERS_FILE}" ]]; then
        s_json=$(jq -c --argjson id "$sel_idx" '.[] | select(.id == $id)' "${SERVERS_FILE}" 2>/dev/null || true)
        if [[ -n "$s_json" ]]; then
            host=$(echo "$s_json" | jq -r '.server')
            port=$(echo "$s_json" | jq -r '.server_port')
            if timeout 5 bash -c "cat < /dev/null > /dev/tcp/${host}/${port}" 2>/dev/null; then
                echo -e "  ${C_GREEN}✓${C_RESET} TCP-соединение с ${host}:${port} устанавливается."
            else
                echo -e "  ${C_RED}✗${C_RESET} Сервер ${host}:${port} недоступен (блокировка провайдера или сервер выключен)."
            fi
        fi
    fi
    echo -e "\n${C_DIM}Последние строки лога ядра:${C_RESET}"
    journalctl -u lincy.service -n 12 --no-pager -o cat 2>/dev/null | sed 's/^/    /'
    echo -e "\n${C_DIM}Полный лог: sudo lincy log${C_RESET}\n"
}

# --- Command: install ---
cmd_install() {
    require_root
    echo -e "\n${C_BOLD}${C_CYAN}=== Установка Lincy CLI VPN Client (Arch Linux) ===${C_RESET}\n"

    if command -v pacman &>/dev/null; then
        log_info "Проверка и установка зависимостей через pacman (jq, curl)..."
        pacman -Sy --noconfirm jq curl || true
    elif command -v apt-get &>/dev/null; then
        log_info "Установка зависимостей через apt (jq, curl)..."
        apt-get update -qq && apt-get install -y -qq jq curl || true
    elif command -v dnf &>/dev/null; then
        dnf install -y jq curl || true
    fi

    if ! command -v jq &>/dev/null; then
        log_err "Не удалось найти утилиту jq. Установите jq вручную: sudo pacman -S jq"
        exit 1
    fi

    local target_sb_ver="1.13.19"
    local force_core="${1:-}"
    local singbox_bin
    singbox_bin=$(singbox_bin_path)
    local cur_sb_ver
    cur_sb_ver=$(singbox_version)

    local need_core=0
    if [[ -z "$singbox_bin" || ! -x "$singbox_bin" ]]; then
        need_core=1
    elif [[ "$cur_sb_ver" != "$target_sb_ver" ]]; then
        log_warn "Установлена версия sing-box ${cur_sb_ver}. Требуется версия ${target_sb_ver} — обновляю..."
        need_core=1
    elif [[ "$force_core" == "--force-core" ]]; then
        need_core=1
    else
        log_ok "Ядро sing-box требуемой версии уже установлено: ${singbox_bin} (v${cur_sb_ver})"
    fi

    if [[ $need_core -eq 1 ]]; then
        local sb_arch
        case "$(uname -m)" in
            x86_64|amd64)   sb_arch="amd64" ;;
            aarch64|arm64)  sb_arch="arm64" ;;
            armv7l|armv7)   sb_arch="armv7" ;;
            i386|i686)      sb_arch="386" ;;
            *)              sb_arch="amd64" ;;
        esac

        log_info "Загрузка ядра sing-box v${target_sb_ver} (linux-${sb_arch})..."
        local dl_tar="/tmp/sing-box.tar.gz"
        local url="https://github.com/SagerNet/sing-box/releases/download/v${target_sb_ver}/sing-box-${target_sb_ver}-linux-${sb_arch}.tar.gz"
        if ! curl -fsSL --max-time 120 -o "$dl_tar" "$url"; then
            log_err "Не удалось скачать ядро sing-box с ${url}"
            exit 1
        fi
        rm -rf /tmp/sing-box-*/ 2>/dev/null || true
        tar -xzf "$dl_tar" -C /tmp
        local extracted
        extracted=$(find /tmp -maxdepth 2 -type f -name "sing-box" -perm -u+x 2>/dev/null | head -n 1)
        if [[ -n "$extracted" ]]; then
            systemctl stop lincy.service 2>/dev/null || true
            install -m 755 "$extracted" /usr/local/bin/sing-box
            if [[ -d /usr/bin && -w /usr/bin ]]; then
                install -m 755 "$extracted" /usr/bin/sing-box
            fi
            singbox_bin="/usr/local/bin/sing-box"
            rm -rf "$dl_tar" /tmp/sing-box-*/
            log_ok "sing-box v${target_sb_ver} установлен: ${singbox_bin} (версия $(singbox_version))"
        else
            log_err "Не удалось распаковать бинарник sing-box."
            exit 1
        fi
    fi

    init_dirs
    local script_src=$(realpath "$0")
    if [[ "$script_src" != "$BIN_TARGET" ]]; then
        cp "$script_src" "$BIN_TARGET"
        chmod 755 "$BIN_TARGET"
        log_ok "Исполняемый файл установлен в ${BIN_TARGET}"
    else
        chmod 755 "$BIN_TARGET"
        log_ok "Исполняемый файл подтверждён в ${BIN_TARGET}"
    fi

    if [[ "$ALT_BIN_TARGET" != "$BIN_TARGET" ]]; then
        ln -sf "$BIN_TARGET" "$ALT_BIN_TARGET" 2>/dev/null || true
        log_ok "Симлинк создан в ${ALT_BIN_TARGET}"
    fi

    # 3. Create systemd service
    ensure_systemd_service
    log_ok "Системный сервис создан: ${SERVICE_FILE}"

    # 4. Generate HWID
    local hwid=$(get_hwid)
    set_state_val "hwid" "$hwid"
    set_state_val "selected_index" "1"
    log_ok "Сгенерирован аппаратный HWID устройства: ${C_CYAN}${hwid}${C_RESET}"

    echo -e "\n${C_BOLD}${C_GREEN}Установка Lincy успешно завершена!${C_RESET}"
    echo -e "Команда доступна из любого места системы:"
    echo -e "  ${C_CYAN}sudo lincy login <ваша_ссылка_на_подписку>${C_RESET}\n"
}

# Значения в ссылке приходят percent-encoded: путь WebSocket выглядит как
# %2F13696%2Fabc, а без декодирования ядро подключается на "/" и трафик молча
# не идёт.
urldecode() {
    local d="${1//+/ }"
    printf '%b' "${d//%/\\x}" 2>/dev/null || echo "$1"
}

# --- Command: login ---
cmd_login() {
    require_root
    local sub_url="$1"
    if [[ -z "$sub_url" ]]; then
        log_err "Укажите URL подписки: sudo lincy login <ссылка_на_подписку>"
        exit 1
    fi

    init_dirs
    local hwid=$(get_state_val "hwid" "$(get_hwid)")
    set_state_val "hwid" "$hwid"
    
    local distro=$(get_distro_name)
    local device=$(get_device_model)
    local ua=$(get_user_agent)

    echo -e "\n${C_BOLD}${C_CYAN}Подключение к подписке Lincy...${C_RESET}"
    log_info "URL:        ${sub_url}"
    log_info "HWID:       ${hwid}"
    log_info "Дистрибутив: ${distro}"
    log_info "Устройство:  ${device}"

    local raw_resp=$(mktemp)

    echo -ne "  ${C_DIM}загрузка подписки...${C_RESET}\r"
    local http_code
    http_code=$(curl -sSL -k --connect-timeout 6 --max-time 15 \
        -H "User-Agent: ${ua}" \
        -H "X-Hwid: ${hwid}" \
        -H "x-hwid: ${hwid}" \
        -H "X-Device-OS: ${distro}" \
        -H "X-Device-Name: ${device}" \
        -H "X-Device-Model: ${device}" \
        -H "Accept: application/json, text/plain, */*" \
        -w "%{http_code}" \
        -o "$raw_resp" \
        "$sub_url" 2>/dev/null || echo "000")
    echo -ne "\033[2K\r"

    if [[ "$http_code" != "200" ]]; then
        log_err "Ошибка загрузки подписки (HTTP $http_code). Проверьте ссылку и доступность сервера."
        if [[ "$http_code" == "404" ]]; then
            log_warn "404 — сервер не нашёл подписку по этому адресу."
        fi
        if [[ -s "$raw_resp" ]]; then
            echo -e "${C_DIM}Ответ сервера (первые 300 символов):${C_RESET}"
            head -c 300 "$raw_resp" | sed 's/^/    /'
            echo
        fi
        rm -f "$raw_resp"
        exit 1
    fi

    local parsed=0
    # 1. Try JSON Array
    if jq -e 'type == "array"' "$raw_resp" >/dev/null 2>&1; then
        jq '[to_entries[] | {
            id: (.key + 1),
            tag: (.value.remarks // "Server #\(.key + 1)"),
            type: (.value.outbounds[0].protocol // "vless"),
            server: (.value.outbounds[0].settings.vnext[0].address // .value.outbounds[0].settings.address // ""),
            server_port: (.value.outbounds[0].settings.vnext[0].port // .value.outbounds[0].settings.port // 443),
            uuid: (.value.outbounds[0].settings.vnext[0].users[0].id // .value.outbounds[0].settings.id // ""),
            flow: (.value.outbounds[0].settings.vnext[0].users[0].flow // .value.outbounds[0].settings.flow // ""),
            network: (.value.outbounds[0].streamSettings.network // "tcp"),
            security: (.value.outbounds[0].streamSettings.security // "reality"),
            sni: (.value.outbounds[0].streamSettings.realitySettings.serverNames[0] // .value.outbounds[0].streamSettings.realitySettings.serverName // .value.outbounds[0].streamSettings.tlsSettings.serverName // "www.mozilla.org"),
            pbk: (.value.outbounds[0].streamSettings.realitySettings.publicKey // ""),
            sid: (.value.outbounds[0].streamSettings.realitySettings.shortIds[0] // .value.outbounds[0].streamSettings.realitySettings.shortId // ""),
            fp: (.value.outbounds[0].streamSettings.realitySettings.fingerprint // .value.outbounds[0].streamSettings.tlsSettings.fingerprint // "chrome"),
            service_name: (.value.outbounds[0].streamSettings.grpcSettings.serviceName // ""),
            raw_json: .value
        }]' "$raw_resp" > "${SERVERS_FILE}"
        parsed=1
    fi

    # 2. Try Base64 / URI Links fallback
    if [[ $parsed -eq 0 ]]; then
        local content=$(cat "$raw_resp")
        if [[ "$content" != *"vless://"* && "$content" != *"vmess://"* ]]; then
            content=$(echo "$content" | base64 -d 2>/dev/null || cat "$raw_resp")
        fi

        local srv_arr="[]"
        local idx=1
        while IFS= read -r line; do
            line=$(echo "$line" | tr -d '\r\n')
            if [[ "$line" == vless://* ]]; then
                local uuid=$(echo "$line" | sed -E 's|vless://([^@]+)@.*|\1|')
                local host_port=$(echo "$line" | sed -E 's|vless://[^@]+@([^/?#]+).*|\1|')
                local host port
                if [[ "$host_port" == *:* ]]; then
                    host="${host_port%:*}"; port="${host_port##*:}"
                else
                    host="$host_port"; port="443"
                fi
                # Ссылка без порта или с мусором вместо него роняла jq --argjson
                [[ "$port" =~ ^[0-9]+$ ]] || port="443"
                local query=$(echo "$line" | sed -E 's|vless://[^?]+\?([^#]+).*|\1|')
                local tag=$(echo "$line" | sed -E 's|vless://.*#(.*)|\1|')
                [[ -z "$tag" || "$tag" == "$line" ]] && tag="${host}:${port}"
                tag=$(printf '%b' "${tag//%/\\x}" 2>/dev/null || echo "$tag")
                
                local flow=$(echo "$query" | grep -oP 'flow=\K[^&]+' || echo "")
                local net=$(echo "$query" | grep -oP 'type=\K[^&]+' || echo "tcp")
                local sec=$(echo "$query" | grep -oP 'security=\K[^&]+' || echo "none")
                local sni=$(echo "$query" | grep -oP 'sni=\K[^&]+' || echo "")
                local fp=$(echo "$query" | grep -oP 'fp=\K[^&]+' || echo "chrome")
                local pbk=$(echo "$query" | grep -oP 'pbk=\K[^&]+' || echo "")
                local sid=$(echo "$query" | grep -oP 'sid=\K[^&]+' || echo "")
                local srv_name=$(echo "$query" | grep -oP 'serviceName=\K[^&]+' || echo "")
                local ws_path=$(echo "$query" | grep -oP 'path=\K[^&]+' || echo "")
                local ws_host=$(echo "$query" | grep -oP 'host=\K[^&]+' || echo "")
                sni=$(urldecode "$sni")
                srv_name=$(urldecode "$srv_name")
                ws_path=$(urldecode "$ws_path")
                ws_host=$(urldecode "$ws_host")
                [[ -z "$ws_path" ]] && ws_path="/"

                srv_arr=$(echo "$srv_arr" | jq \
                    --argjson id "$idx" \
                    --arg tag "$tag" \
                    --arg type "vless" \
                    --arg server "$host" \
                    --argjson port "${port:-443}" \
                    --arg uuid "$uuid" \
                    --arg flow "$flow" \
                    --arg net "$net" \
                    --arg sec "$sec" \
                    --arg sni "$sni" \
                    --arg fp "$fp" \
                    --arg pbk "$pbk" \
                    --arg sid "$sid" \
                    --arg srv "$srv_name" \
                    --arg wspath "$ws_path" \
                    --arg wshost "$ws_host" \
                    '. += [{
                        id: $id,
                        tag: $tag,
                        type: $type,
                        server: $server,
                        server_port: $port,
                        uuid: $uuid,
                        flow: $flow,
                        network: $net,
                        security: $sec,
                        sni: $sni,
                        fp: $fp,
                        pbk: $pbk,
                        sid: $sid,
                        service_name: $srv,
                        ws_path: $wspath,
                        ws_host: $wshost
                    }]')
                idx=$((idx + 1))
            fi
        done <<< "$content"

        if [[ $(echo "$srv_arr" | jq 'length') -gt 0 ]]; then
            echo "$srv_arr" > "${SERVERS_FILE}"
            parsed=1
        fi
    fi
    rm -f "$raw_resp"

    if [[ $parsed -eq 0 || ! -f "${SERVERS_FILE}" || $(jq 'length' "${SERVERS_FILE}" 2>/dev/null || echo 0) -eq 0 ]]; then
        log_err "Не удалось извлечь серверы из ответа подписки."
        exit 1
    fi

    local total_count=$(jq 'length' "${SERVERS_FILE}")
    set_state_val "sub_url" "${used_url:-$sub_url}"
    set_state_val "last_update" "$(date +%s)"
    set_state_val "selected_index" "1"

    log_ok "Успешно получено серверов: ${total_count}"

    local first_server=$(jq '.[0]' "${SERVERS_FILE}")
    generate_config "$first_server"

    echo -e "\n${C_BOLD}Список доступных серверов:${C_RESET}"
    cmd_servers
    echo -e "\nДля выбора сервера выполните: ${C_CYAN}sudo lincy use <номер>${C_RESET}"
    echo -e "Для включения VPN выполните:  ${C_CYAN}sudo lincy on${C_RESET}\n"
}

# --- Server Flag & Tag Formatter ---
get_country_flag() {
    local name="$1"
    [[ -z "$name" ]] && { echo "🌐 "; return; }

    # UTF-8 локаль нужна и для grep -P, и для регистронезависимого сравнения кириллицы.
    local -x LC_ALL="C.UTF-8" LANG="C.UTF-8" LC_CTYPE="C.UTF-8"

    # Если в названии уже есть флаг (пара Regional Indicator символов) — не дублируем.
    if printf '%s' "$name" | grep -qP '[\x{1F1E6}-\x{1F1FF}]{2}' 2>/dev/null; then
        echo ""
        return
    fi

    local upper
    upper=$(printf '%s' "$name" | tr '[:lower:]' '[:upper:]')

    local _nocase_was_set=0
    shopt -q nocasematch && _nocase_was_set=1
