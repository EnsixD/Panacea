# --- Command: servers ---
cmd_servers() {
    if [[ ! -f "${SERVERS_FILE}" ]]; then
        log_warn "Список серверов пуст. Выполните: sudo lincy login <ссылка_на_подписку>"
        return
    fi

    local sel_idx=$(get_state_val "selected_index" "1")
    local total=$(jq 'length' "${SERVERS_FILE}" 2>/dev/null || echo 0)

    if [[ "$total" -eq 0 ]]; then
        log_warn "Список серверов пуст."
        return
    fi

    echo -e "\n${C_BOLD}${C_CYAN}  ДОСТУПНЫЕ СЕРВЕРЫ LINCY (${total})${C_RESET}"
    echo -e "${C_DIM}  ────────────────────────────────────────────────────────────────────────${C_RESET}"

    jq -c '.[]' "${SERVERS_FILE}" | while read -r s; do
        local sid=$(echo "$s" | jq -r '.id')
        local tag=$(echo "$s" | jq -r '.tag')
        local type=$(echo "$s" | jq -r '.type // "vless"' | tr '[:lower:]' '[:upper:]')
        local net=$(echo "$s" | jq -r '.network // "tcp"' | tr '[:lower:]' '[:upper:]')
        local sec=$(echo "$s" | jq -r '.security // "none"' | tr '[:lower:]' '[:upper:]')
        local host=$(echo "$s" | jq -r '.server')
        local port=$(echo "$s" | jq -r '.server_port')
        local has_raw=$(echo "$s" | jq -r 'if .raw_json != null then "JSON" else "RAW" end')

        local flag=$(get_country_flag "$tag")
        local is_sel=0
        [[ "$sid" == "$sel_idx" ]] && is_sel=1

        # Format tags like client: VLESS / TCP / REALITY / JSON
        local sub_tags="${type} / ${net} / ${sec} / ${has_raw}"

        if [[ $is_sel -eq 1 ]]; then
            echo -e "${C_CYAN}▎${C_RESET} ${C_BOLD}${C_GREEN}● [${sid}] ${flag}${tag}${C_RESET}  ${C_GREEN}${C_BOLD}[ВЫБРАН]${C_RESET}"
            echo -e "${C_CYAN}▎${C_RESET}   ${C_DIM}${sub_tags}${C_RESET}"
            echo -e "${C_DIM}  ┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄${C_RESET}"
        else
            echo -e "  ${C_DIM}○ [${sid}]${C_RESET} ${C_BOLD}${flag}${tag}${C_RESET}"
            echo -e "      ${C_DIM}${sub_tags}${C_RESET}"
            echo -e "${C_DIM}  ┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄${C_RESET}"
        fi
    done

    echo -e "  ${C_DIM}Активен сервер #${sel_idx} из ${total}${C_RESET}\n"
}

# --- Command: use ---
cmd_use() {
    require_root
    local target_id="$1"
    if [[ -z "$target_id" || ! "$target_id" =~ ^[0-9]+$ ]]; then
        log_err "Укажите числовой номер сервера: sudo lincy use <ID>"
        exit 1
    fi

    if [[ ! -f "${SERVERS_FILE}" ]]; then
        log_err "Список серверов пуст. Сначала выполните login."
        exit 1
    fi

    local server_json=$(jq -c --argjson id "$target_id" '.[] | select(.id == $id)' "${SERVERS_FILE}")
    if [[ -z "$server_json" ]]; then
        local max_id=$(jq 'length' "${SERVERS_FILE}")
        log_err "Сервер #${target_id} не найден. Доступно: 1..${max_id}"
        exit 1
    fi

    local tag=$(echo "$server_json" | jq -r '.tag')
    set_state_val "selected_index" "$target_id"

    generate_config "$server_json"
    log_ok "Выбран сервер #${target_id}: ${C_BOLD}${tag}${C_RESET}"

    if [[ -f "${SERVICE_FILE}" ]] && systemctl is-active --quiet lincy.service 2>/dev/null; then
        log_info "Перезапуск VPN туннеля..."
        systemctl restart lincy.service
        sleep 1
        log_ok "Туннель ${TUN_INTERFACE} переключен на сервер #${target_id}!"
    else
        echo -e "Для включения туннеля выполните: ${C_CYAN}sudo lincy on${C_RESET}"
    fi
}

# --- Helper: Check real traffic passage through all subscription servers ---
check_all_servers_traffic() {
    if [[ ! -f "${SERVERS_FILE}" ]]; then
        log_err "Список серверов пуст. Выполните: sudo lincy login <ссылка_на_подписку>"
        return 1
    fi

    local total
    total=$(jq 'length' "${SERVERS_FILE}" 2>/dev/null || echo 0)
    if [[ "$total" -eq 0 ]]; then
        log_err "Список серверов пуст."
        return 1
    fi

    local bin
    bin=$(singbox_bin_path)
    if [[ ! -x "$bin" ]]; then
        log_err "Ядро sing-box не найдено (${bin}). Выполните: sudo lincy install"
        return 1
    fi

    echo -e "\n${C_BOLD}${C_CYAN}Автоматическая проверка прохождения трафика по всем серверам...${C_RESET}"
    echo -e "${C_DIM}Всего серверов: ${total}. Проверяется установление соединения и передача данных (HTTP GET).${C_RESET}\n"

    local direct_dns
    direct_dns=$(detect_direct_dns)
    local test_cfg
    test_cfg=$(mktemp --suffix=.json)

    if ! jq --arg direct_dns "$direct_dns" '
    {
      "log": { "level": "panic" },
      "dns": {
        "servers": [
          { "tag": "direct-dns", "type": "udp", "server": $direct_dns, "server_port": 53, "detour": "direct" }
        ],
        "strategy": "ipv4_only"
      },
      "inbounds": [
        to_entries[] | {
          "type": "socks",
          "tag": ("in-" + (.value.id | tostring)),
          "listen": "127.0.0.1",
          "listen_port": (25800 + .value.id)
        }
      ],
      "outbounds": (
        [
          to_entries[] | .value as $s |
          (
            if $s.raw_json != null then
              (first($s.raw_json.outbounds[]? | select(.tag == "proxy" or .tag == "default")) // $s.raw_json.outbounds[0])
            else null end
          ) as $ob |
          (if $ob != null then ($ob.streamSettings // {}) else null end) as $ss |
          (if $ss != null then ($ss.network // "tcp") else ($s.network // "tcp") end) as $net |
          (if $ss != null then ($ss.security // "none") else ($s.security // "none") end) as $sec |
          (if $ob != null then ($ob.settings.address // $ob.settings.vnext[0].address // $s.server // "") else ($s.server // "") end) as $host |
          (if $ob != null then (($ob.settings.port // $ob.settings.vnext[0].port // $s.server_port // 443) | tonumber) else (($s.server_port // 443) | tonumber) end) as $port |
          (if $ob != null then ($ob.settings.id // $ob.settings.vnext[0].users[0].id // $s.uuid // "") else ($s.uuid // "") end) as $uuid |
          (if $ob != null then ($ob.settings.flow // $ob.settings.vnext[0].users[0].flow // $s.flow // "") else ($s.flow // "") end) as $flow_raw |
          (if $ss != null then ($ss.realitySettings.serverName // $ss.realitySettings.serverNames[0] // $ss.tlsSettings.serverName // $s.sni // "") else ($s.sni // "") end) as $sni |
          (if $ss != null then ($ss.realitySettings.fingerprint // $ss.tlsSettings.fingerprint // $s.fp // "chrome") else ($s.fp // "chrome") end) as $fp |
          (if $ss != null then ($ss.realitySettings.publicKey // $s.pbk // "") else ($s.pbk // "") end) as $pbk |
          (if $ss != null then ($ss.realitySettings.shortId // $ss.realitySettings.shortIds[0] // $s.sid // "") else ($s.sid // "") end) as $sid |
          (if $ss != null then ($ss.grpcSettings.serviceName // $s.service_name // "") else ($s.service_name // "") end) as $grpc_name |
          (if $ss != null then ($ss.wsSettings.path // $s.ws_path // "/") else ($s.ws_path // "/") end) as $ws_path |
          (if $ss != null then ($ss.wsSettings.headers // {}) else (if (($s.ws_host // "") != "") then { Host: $s.ws_host } else {} end) end) as $ws_headers |
          (if $net == "tcp" then $flow_raw else "" end) as $flow |
          (
            {
              "type": "vless",
              "tag": ("proxy-" + ($s.id | tostring)),
              "server": (if $host == "" then "127.0.0.1" else $host end),
              "server_port": $port,
              "uuid": (if $uuid == "" then "00000000-0000-0000-0000-000000000000" else $uuid end),
              "packet_encoding": "xudp"
            }
            | (if $flow != "" then (.flow = $flow) else . end)
            | (if ($sec == "reality" or $sec == "tls") then
                  (.tls = {
                      "enabled": true,
                      "server_name": (if $sni == "" then "www.mozilla.org" else $sni end),
                      "utls": { "enabled": true, "fingerprint": $fp }
                  })
               else . end)
            | (if ($sec == "reality" and $pbk != "") then
                  (.tls.reality = ({ "enabled": true, "public_key": $pbk }
                                   | (if $sid != "" then (.short_id = $sid) else . end)))
               else . end)
            | (if $net == "grpc" then
                  (.transport = ({ "type": "grpc" }
                                 | (if $grpc_name != "" then (.service_name = $grpc_name) else . end)))
               elif $net == "ws" then
                  (.transport = { "type": "ws", "path": $ws_path, "headers": $ws_headers })
               elif ($net == "httpupgrade" or $net == "xhttp") then
                  (.transport = { "type": "httpupgrade", "path": $ws_path })
               else . end)
            | .domain_resolver = "direct-dns"
          )
        ] + [ { "type": "direct", "tag": "direct", "domain_resolver": "direct-dns" } ]
      ),
      "route": {
        "rules": [
          to_entries[] | {
            "inbound": ("in-" + (.value.id | tostring)),
            "outbound": ("proxy-" + (.value.id | tostring))
          }
        ],
        "auto_detect_interface": true
      }
    }
    ' "${SERVERS_FILE}" > "$test_cfg"; then
        rm -f "$test_cfg"
        log_err "Не удалось сформировать конфигурацию для проверки серверов."
        return 1
    fi

    "$bin" run -c "$test_cfg" &>/dev/null &
    local test_pid=$!
    sleep 0.5

    if ! kill -0 "$test_pid" 2>/dev/null; then
        rm -f "$test_cfg"
        log_err "Не удалось запустить тестовый экземпляр ядра sing-box."
        return 1
    fi

    local sel_idx
    sel_idx=$(get_state_val "selected_index" "1")

    local -a res_id res_tag res_proto res_status res_ms res_ip
    local working_count=0
    local first_working_id=""
    local cur_working=0

    local s_idx=0
    while IFS= read -r s_line; do
        s_idx=$((s_idx + 1))
        local sid=$(echo "$s_line" | jq -r '.id')
        local tag=$(echo "$s_line" | jq -r '.tag')
        local type=$(echo "$s_line" | jq -r '.type // "vless"' | tr '[:lower:]' '[:upper:]')
        local net=$(echo "$s_line" | jq -r '.network // "tcp"' | tr '[:lower:]' '[:upper:]')
        local sec=$(echo "$s_line" | jq -r '.security // ""' | tr '[:lower:]' '[:upper:]')
        local proto="${type}+${net}"
        [[ -n "$sec" && "$sec" != "NONE" ]] && proto="${proto}/${sec}"

        local port=$((25800 + sid))
        echo -ne "  [${s_idx}/${total}] Проверка: ${tag:0:30} (${proto})...\r"

        local resp
        resp=$(curl -4 -s -w "\n%{http_code}\n%{time_total}" --connect-timeout 2 --max-time 3 \
            -x "socks5h://127.0.0.1:${port}" "https://api.ipify.org" 2>/dev/null || echo -e "\n000\n0")

        local ext_ip http_code dur_sec dur_ms
        ext_ip=$(echo "$resp" | sed -n '1p' | tr -d '\r\n[:space:]')
        http_code=$(echo "$resp" | sed -n '2p' | tr -d '\r\n[:space:]')
        dur_sec=$(echo "$resp" | sed -n '3p' | tr -d '\r\n[:space:]')
        dur_ms=$(awk -v t="$dur_sec" 'BEGIN {printf "%.0f", t*1000}' 2>/dev/null || echo "0")

        res_id+=("$sid")
        res_tag+=("$tag")
        res_proto+=("$proto")

        if [[ "$http_code" == "200" && "$ext_ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            res_status+=("OK")
            res_ms+=("$dur_ms")
            res_ip+=("$ext_ip")
            working_count=$((working_count + 1))
            [[ -z "$first_working_id" ]] && first_working_id="$sid"
            [[ "$sid" == "$sel_idx" ]] && cur_working=1
        else
            res_status+=("FAIL")
            res_ms+=("$dur_ms")
            res_ip+=("")
        fi
    done < <(jq -c '.[]' "${SERVERS_FILE}")

    echo -ne "\033[2K\r"
    kill "$test_pid" 2>/dev/null || true
    wait "$test_pid" 2>/dev/null || true
    rm -f "$test_cfg"

    echo -e "${C_BOLD}══════════════════════════════════════════════════════════════════════════════════════════════════════════════${C_RESET}"
    printf "${C_BOLD} %-4s │ %-21s │ %-45s │ %s${C_RESET}\n" "ID" "ПРОТОКОЛ" "СЕРВЕР / ЛОКАЦИЯ" "ТРАФИК"
    echo -e "${C_BOLD}──────────────────────────────────────────────────────────────────────────────────────────────────────────────${C_RESET}"

    local i
    for ((i=0; i<${#res_id[@]}; i++)); do
        local sid="${res_id[$i]}"
        local tag="${res_tag[$i]}"
        local proto="${res_proto[$i]}"
        local st="${res_status[$i]}"
        local ms="${res_ms[$i]}"
        local ip="${res_ip[$i]}"

        local prefix="  "
        [[ "$sid" == "$sel_idx" ]] && prefix="* "

        local status_str
        if [[ "$st" == "OK" ]]; then
            status_str="${C_GREEN}● Работает${C_RESET} (${ms} ms) [${ip}]"
        else
            status_str="${C_RED}○ Не проходит${C_RESET}"
        fi

        printf " %-4s │ %-21s │ %-45s │ %b\n" \
            "${prefix}${sid}" "$proto" "$tag" "$status_str"
    done
    echo -e "${C_BOLD}══════════════════════════════════════════════════════════════════════════════════════════════════════════════${C_RESET}"
    echo -e "${C_DIM}(*) — текущий выбранный сервер${C_RESET}\n"

    if [[ $working_count -eq 0 ]]; then
        log_err "Ни один сервер не пропустил трафик! Проверьте сеть или подписку."
        return 2
    fi

    log_ok "Серверов с рабочим трафиком: ${C_BOLD}${working_count} из ${total}${C_RESET}."
    if [[ $cur_working -eq 1 ]]; then
        log_ok "Выбранный сервер #${sel_idx} подтвердил прохождение трафика."
    else
        log_warn "Выбранный сервер #${sel_idx} не пропускает трафик."
        if [[ -n "$first_working_id" ]]; then
            log_info "Автоматически переключаюсь на рабочий сервер #${first_working_id}..."
            set_state_val "selected_index" "$first_working_id"
            local new_json
            new_json=$(jq -c --argjson id "$first_working_id" '.[] | select(.id == $id)' "${SERVERS_FILE}" 2>/dev/null || true)
            if [[ -n "$new_json" ]]; then
                generate_config "$new_json"
            fi
        fi
    fi
    return 0
}

# --- Command: on ---
cmd_on() {
    require_root
    if [[ ! -f "${SERVERS_FILE}" ]]; then
        log_err "Подписка не найдена. Сначала выполните: sudo lincy login <ссылка_на_подписку>"
        exit 1
    fi

    echo -e "\n${C_BOLD}${C_CYAN}Запуск туннеля Lincy (${TUN_INTERFACE})${C_RESET}\n"

    # 1. Физическая сеть должна работать ДО поднятия туннеля
    log_info "Проверка сетевого адаптера..."
    if ! check_network_adapter; then
        log_err "Туннель не будет запущен: нет рабочего сетевого подключения."
        exit 1
    fi

    # 2. Проверка прохождения трафика по всем серверам по очереди и протоколам
    if ! check_all_servers_traffic; then
        log_err "Туннель не запущен: серверы не пропускают трафик."
        exit 1
    fi

    # 3. Поддержка TUN в ядре
    ensure_tun_device || exit 1

    # 4. Чистый старт
    systemctl stop lincy.service 2>/dev/null || true
    ip link del "${TUN_INTERFACE}" 2>/dev/null || true

    # 4. Генерация и валидация конфига
    local sel_idx s_json
    sel_idx=$(get_state_val "selected_index" "1")
    s_json=$(jq -c --argjson id "$sel_idx" '.[] | select(.id == $id)' "${SERVERS_FILE}" 2>/dev/null || true)
    [[ -z "$s_json" ]] && s_json=$(jq -c '.[0]' "${SERVERS_FILE}")
    if [[ -z "$s_json" || "$s_json" == "null" ]]; then
        log_err "Не удалось получить данные выбранного сервера."
        exit 1
    fi
    if ! generate_config "$s_json"; then
        log_err "Конфигурация не создана. Туннель не запущен."
        exit 1
    fi
    log_ok "Конфигурация проверена ядром sing-box."

    # 5. Служба
    ensure_systemd_service

    log_info "Поднятие туннеля..."
    systemctl start lincy.service || true

    local rc=0
    wait_tun_up 15 || rc=$?
    if [[ $rc -eq 2 ]]; then
        log_err "Служба упала сразу после запуска."
        diagnose_tunnel
        exit 1
    elif [[ $rc -eq 1 ]]; then
        log_warn "Интерфейс ${TUN_INTERFACE} не поднялся за 15 с. Пробую другой сетевой стек..."
        local cur_stack
        cur_stack=$(get_state_val "tun_stack" "gvisor")
        if [[ "$cur_stack" == "gvisor" ]]; then
            set_state_val "tun_stack" "system"
        else
            set_state_val "tun_stack" "gvisor"
        fi
        systemctl stop lincy.service 2>/dev/null || true
        generate_config "$s_json" && systemctl start lincy.service || true
        if ! wait_tun_up 15; then
            log_err "Туннель ${TUN_INTERFACE} так и не поднялся."
            diagnose_tunnel
            exit 1
        fi
        log_ok "Туннель поднялся на стеке $(get_state_val "tun_stack" "gvisor")."
    fi

    log_ok "Интерфейс ${C_BOLD}${TUN_INTERFACE}${C_RESET} поднят, маршруты установлены."

    # 6. Проверяем, что трафик реально идёт
    log_info "Проверка прохождения трафика..."
    local ext_ip
    if ext_ip=$(verify_tunnel_traffic); then
        log_ok "Трафик идёт через туннель. Внешний IP: ${C_BOLD}${ext_ip}${C_RESET}"
        set_state_val "last_ip" "$ext_ip"
    else
        log_err "Туннель поднят, но трафик не проходит."
        log_warn "Пробую перезапустить ядро один раз..."
        systemctl restart lincy.service
        sleep 4
        if ext_ip=$(verify_tunnel_traffic); then
            log_ok "После перезапуска трафик пошёл. Внешний IP: ${C_BOLD}${ext_ip}${C_RESET}"
        else
            diagnose_tunnel
            log_warn "Чтобы вернуть интернет без VPN, выполните: ${C_CYAN}sudo lincy off${C_RESET}"
            exit 1
        fi
    fi

    cmd_status
}
# --- Command: off ---
cmd_off() {
    require_root
    log_info "Выключение VPN туннеля Lincy (${TUN_INTERFACE})..."
    systemctl stop lincy.service 2>/dev/null || true
    sleep 1

    # Подчищаем остатки, если ядро завершилось некорректно
    ip link del "${TUN_INTERFACE}" 2>/dev/null || true
    ip rule del table 2022 2>/dev/null || true
    ip -6 rule del table 2022 2>/dev/null || true
    resolvectl flush-caches 2>/dev/null || true

    log_ok "VPN туннель выключен."

    local ext_ip
    ext_ip=$(curl -4 -s --max-time 5 https://api.ipify.org 2>/dev/null || echo "")
    ext_ip=$(echo "$ext_ip" | tr -d '\r\n[:space:]')
    if [[ "$ext_ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        log_ok "Прямое соединение восстановлено. Внешний IP: ${ext_ip}"
    else
        log_warn "Прямое соединение не отвечает. Проверяю сетевой адаптер..."
        check_network_adapter || true
    fi
}

# --- Command: restart ---
cmd_restart() {
    require_root
    log_info "Перезапуск VPN туннеля Lincy..."
    check_network_adapter || log_warn "Проблемы с физической сетью — туннель может не подняться."
    systemctl restart lincy.service
    if wait_tun_up 15; then
        log_ok "Туннель ${TUN_INTERFACE} перезапущен."
        local ext_ip
        if ext_ip=$(verify_tunnel_traffic); then
            log_ok "Трафик проходит. Внешний IP: ${C_BOLD}${ext_ip}${C_RESET}"
        else
            log_err "Туннель поднят, но трафик не проходит."
            diagnose_tunnel
        fi
    else
        log_err "Туннель не поднялся после перезапуска."
        diagnose_tunnel
    fi
    cmd_status
}

# --- Command: doctor (диагностика и авторемонт) ---
cmd_doctor() {
    require_root
    echo -e "\n${C_BOLD}${C_CYAN}=== Диагностика Lincy ===${C_RESET}\n"

    echo -e "${C_BOLD}1. Сетевой адаптер${C_RESET}"
    if check_network_adapter; then
        log_ok "Физическая сеть в порядке."
    else
        log_err "Физическая сеть неисправна — сначала нужно починить её."
        return 1
    fi

    echo -e "\n${C_BOLD}2. Ядро sing-box${C_RESET}"
    local bin ver
    bin=$(singbox_bin_path)
    ver=$(singbox_version)
    if [[ -x "$bin" ]]; then
        log_ok "Ядро: ${bin} (версия ${ver})"
        singbox_is_legacy && log_warn "Версия устарела (<1.12). Обновите: sudo lincy install --force-core"
    else
        log_err "Ядро sing-box не найдено. Выполните: sudo lincy install"
        return 1
    fi

    echo -e "\n${C_BOLD}3. Поддержка TUN${C_RESET}"
    ensure_tun_device && log_ok "TUN доступен."

    echo -e "\n${C_BOLD}4. Конфигурация${C_RESET}"
    if [[ -f "${RUNTIME_CONFIG}" ]]; then
        if "$bin" check -c "${RUNTIME_CONFIG}" &>/dev/null; then
            log_ok "Конфиг валиден."
        else
            log_warn "Конфиг невалиден — перегенерирую..."
            local sel_idx s_json
            sel_idx=$(get_state_val "selected_index" "1")
            s_json=$(jq -c --argjson id "$sel_idx" '.[] | select(.id == $id)' "${SERVERS_FILE}" 2>/dev/null || jq -c '.[0]' "${SERVERS_FILE}")
            generate_config "$s_json" && log_ok "Конфиг пересоздан."
        fi
    else
        log_warn "Конфиг отсутствует."
    fi

    echo -e "\n${C_BOLD}5. Туннель${C_RESET}"
    diagnose_tunnel
}

# --- Command: status ---
cmd_status() {
    local is_active=0
    if systemctl is-active --quiet lincy.service 2>/dev/null; then
        is_active=1
    fi

    local sel_idx=$(get_state_val "selected_index" "1")
    local hwid=$(get_state_val "hwid" "$(get_hwid)")
    local s_tag="Не выбран"
    local s_host="-"
    local s_proto="-"

    if [[ -f "${SERVERS_FILE}" ]]; then
        local s_json=$(jq -c --argjson id "$sel_idx" '.[] | select(.id == $id)' "${SERVERS_FILE}" 2>/dev/null || true)
        if [[ -n "$s_json" ]]; then
            s_tag=$(echo "$s_json" | jq -r '.tag // "Unknown"')
            s_host="$(echo "$s_json" | jq -r '.server'):$(echo "$s_json" | jq -r '.server_port')"
            s_proto="$(echo "$s_json" | jq -r '.type | ascii_upcase') / $(echo "$s_json" | jq -r '.network')"
        fi
    fi

    local distro=$(get_distro_name)
    local device=$(get_device_model)

    echo -e "\n${C_BOLD}${C_CYAN}=== Состояние Lincy VPN Client ===${C_RESET}\n"
    if [[ $is_active -eq 1 ]]; then
        echo -e "Статус службы:        ${C_GREEN}${C_BOLD}● РАБОТАЕТ (Active)${C_RESET}"
    else
        echo -e "Статус службы:        ${C_RED}${C_BOLD}○ ВЫКЛЮЧЕН (Inactive)${C_RESET}"
    fi

    # Состояние физического адаптера
    local up_iface
    up_iface=$(detect_uplink_iface || true)
    if [[ -n "$up_iface" ]]; then
        local ipaddr
        ipaddr=$(ip -4 -o addr show dev "$up_iface" scope global 2>/dev/null | awk '{print $4}' | head -n1)
        echo -e "Сетевой адаптер:      ${C_GREEN}${up_iface} UP${C_RESET} ${C_DIM}${ipaddr}${C_RESET}"
    else
        echo -e "Сетевой адаптер:      ${C_RED}${C_BOLD}DOWN — физической сети нет${C_RESET}"
        echo -e "                      ${C_DIM}Запустите: sudo lincy doctor${C_RESET}"
    fi

    # Состояние туннеля
    if ip link show "${TUN_INTERFACE}" &>/dev/null; then
        if ip route show table all 2>/dev/null | grep -q "${TUN_INTERFACE}"; then
            echo -e "Интерфейс туннеля:    ${C_GREEN}${TUN_INTERFACE} UP (маршруты активны)${C_RESET}"
        else
            echo -e "Интерфейс туннеля:    ${C_YELLOW}${TUN_INTERFACE} есть, но маршруты не установлены${C_RESET}"
        fi
    else
        echo -e "Интерфейс туннеля:    ${C_RED}${TUN_INTERFACE} отсутствует${C_RESET}"
    fi

    echo -e "Дистрибутив ОС:       ${distro}"
    echo -e "Устройство / Хост:    ${device}"
    echo -e "Активный сервер:      ${C_BOLD}#${sel_idx} - ${s_tag}${C_RESET}"
    echo -e "Узел назначения:      ${s_host}"
    echo -e "Протокол соединения:  ${s_proto}"
    echo -e "Аппаратный HWID:      ${hwid}"

    if [[ $is_active -eq 1 ]]; then
        echo -e "\n${C_BOLD}Проверка соединения:${C_RESET}"
        local ext_ip
        ext_ip=$(curl -4 -s --connect-timeout 3 --max-time 5 https://api.ipify.org 2>/dev/null || echo "")
        ext_ip=$(echo "$ext_ip" | tr -d '\r\n[:space:]')
        if [[ "$ext_ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            echo -e "  Внешний IP адрес:     ${C_GREEN}${C_BOLD}${ext_ip}${C_RESET}"
            echo -e "  Прохождение трафика:  ${C_GREEN}${C_BOLD}● Работает${C_RESET}"
        else
            echo -e "  Внешний IP адрес:     ${C_RED}не определён${C_RESET}"
            echo -e "  Прохождение трафика:  ${C_RED}${C_BOLD}○ Трафик не идёт${C_RESET}"
            echo -e "  ${C_DIM}Диагностика: sudo lincy doctor | Выключить VPN: sudo lincy off${C_RESET}"
        fi
    fi
    echo ""
}

# --- Helper: Check specific endpoint availability and latency ---
check_endpoint() {
    local name="$1"
    local url="$2"
    local out code time_sec ms
    out=$(curl -4 -o /dev/null -s -w "%{http_code} %{time_total}" --max-time 6 "$url" 2>/dev/null || echo "000 0")
    code=$(echo "$out" | awk '{print $1}')
    time_sec=$(echo "$out" | awk '{print $2}')
    ms=$(awk "BEGIN {printf \"%.0f\", $time_sec * 1000}" 2>/dev/null || echo "0")

    if [[ "$code" =~ ^(200|204|301|302|307|308|403|404|405)$ ]] && [[ "$ms" -gt 0 ]]; then
        printf "  %-22s ${C_GREEN}● Доступен${C_RESET} (${ms} ms)\n" "$name:"
    else
        printf "  %-22s ${C_RED}○ Недоступен${C_RESET}\n" "$name:"
    fi
}

# --- Command: test ---
cmd_test() {
    echo -e "\n${C_BOLD}${C_CYAN}Тестирование соединения Lincy VPN...${C_RESET}\n"
    local ext_ip
    ext_ip=$(curl -4 -s --connect-timeout 3 --max-time 5 https://api.ipify.org 2>/dev/null || echo "")
    ext_ip=$(echo "$ext_ip" | tr -d '\r\n[:space:]')
    if [[ "$ext_ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo -e "  Внешний IP адрес:     ${C_GREEN}${C_BOLD}${ext_ip}${C_RESET}"
    else
        echo -e "  Внешний IP адрес:     ${C_RED}Туннель не активен или нет сети${C_RESET}"
    fi

    if [[ -f "${SERVERS_FILE}" ]]; then
        check_all_servers_traffic || true
    fi

    if systemctl is-active --quiet lincy.service 2>/dev/null; then
        echo -e "\n${C_BOLD}Проверка доступности ключевых сервисов:${C_RESET}"
        check_endpoint "YouTube" "https://www.youtube.com"
        check_endpoint "ChatGPT / OpenAI" "https://chatgpt.com"
        check_endpoint "Google" "https://www.google.com"
        check_endpoint "GitHub" "https://github.com"
        check_endpoint "Instagram" "https://www.instagram.com"
        check_endpoint "Прямой доступ (RU)" "https://ya.ru"
        echo ""
    fi
}

# --- Command: log ---
cmd_log() {
    journalctl -u lincy.service -f -n 30 --no-pager
}

# --- Command: uninstall ---
cmd_uninstall() {
    require_root
    echo -e "\n${C_YELLOW}Удаление Lincy VPN Client...${C_RESET}"
    systemctl stop lincy.service 2>/dev/null || true
    systemctl disable lincy.service 2>/dev/null || true

    rm -f "${SERVICE_FILE}" "${BIN_TARGET}" "${ALT_BIN_TARGET}"
    rm -rf "${CONFIG_DIR}"
    systemctl daemon-reload 2>/dev/null || true

    log_ok "Lincy успешно и полностью удален из системы."
}

# --- Help ---
print_help() {
    echo -e "
${C_BOLD}${C_CYAN}Lincy CLI VPN Client v${VERSION} (Native Arch Linux & Linux)${C_RESET}

${C_BOLD}Использование:${C_RESET}
  sudo lincy <команда> [параметры]

${C_BOLD}Основные команды:${C_RESET}
  ${C_GREEN}sudo lincy install${C_RESET}            Установить sing-box, службу и добавить lincy в PATH
  ${C_GREEN}sudo lincy install --force-core${C_RESET} Переустановить/обновить ядро sing-box
  ${C_GREEN}sudo lincy login <suburl>${C_RESET}     Добавить подписку (RAW, JSON, Base64), отправить HWID и загрузить серверы
  ${C_GREEN}sudo lincy servers${C_RESET}            Отобразить список серверов и обновить подписку
  ${C_GREEN}sudo lincy use <ID>${C_RESET}           Выбрать активный сервер по номеру (например: sudo lincy use 1)
  ${C_GREEN}sudo lincy on${C_RESET}                 Включить VPN туннель (${TUN_INTERFACE})
  ${C_GREEN}sudo lincy off${C_RESET}                Выключить VPN туннель
  ${C_GREEN}sudo lincy status${C_RESET}             Показать статус туннеля, внешний IP и проверку сервисов
  ${C_GREEN}sudo lincy test${C_RESET}               Тест доступности YouTube, ChatGPT, Google, Direct RU
  ${C_GREEN}sudo lincy restart${C_RESET}            Перезапустить VPN туннель
  ${C_GREEN}sudo lincy doctor${C_RESET}             Диагностика адаптера, ядра, конфига и туннеля + авторемонт
  ${C_GREEN}sudo lincy log${C_RESET}                Просмотр логов ядра в реальном времени
  ${C_GREEN}sudo lincy uninstall${C_RESET}          Полное удаление Lincy из системы
"
}

# --- Main Entry Point ---
main() {
    local cmd="${1:-}"
    case "${cmd,,}" in
        install)
            cmd_install "${2:-}"
            ;;
        login)
            cmd_login "${2:-}"
            ;;
        use|select)
            cmd_use "${2:-1}"
            ;;
        servers|list|ls)
            cmd_servers
            ;;
        on|start|up|connect)
            cmd_on
            ;;
        off|stop|down|disconnect)
            cmd_off
            ;;
        restart)
            cmd_restart
            ;;
        status)
            cmd_status
            ;;
        test|check|ping)
            cmd_test
            ;;
        log|logs)
            cmd_log
            ;;
        doctor|fix|diag)
            cmd_doctor
            ;;
        uninstall)
            cmd_uninstall
            ;;
        -h|--help|help|"")
            print_help
            ;;
        *)
            log_err "Неизвестная команда '${cmd}'."
            print_help
            exit 1
            ;;
    esac
}

main "$@"
