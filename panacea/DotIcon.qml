import QtQuick

// Погодный значок точками — пара к DotText.
//
// Той же сеткой в семь рядов и теми же кружками, что и цифры: значок стоит
// с ними в одной строке, и любой другой рисунок читался бы как вставка из
// чужого набора. Размер задаётся высотой в пикселях — как у текста.
//
// Рисунки нарочно грубые. На высоте в полтора десятка пикселей подробности
// всё равно съедаются, а узнаётся погода по силуэту: у облака два бугорка
// разной высоты, у солнца круг с лучами, у дождя облако и капли под ним.
//
// У облака левый бугорок ниже правого, а по углам точек нет — выходит
// небольшой скос. Ровные углы и одинаковые бугорки давали кирпич с двумя
// шишками; вся разница между ним и облаком в этой асимметрии.
//
// Бугорок сложен ступенькой: три точки сверху, пять под ними. Одной
// ступени мало — переход от вершины сразу к телу читается обрывом, — а
// больше двух на семь рядов не влезает.
//
// Правый бок выше левого: в крайнем правом столбце четыре точки против
// трёх слева. Иначе облако выходит симметричным, а симметричное облако
// читается геометрической фигурой.
//
// Отсюда и ширина в тринадцать столбцов: два бугорка по пять точек в
// основании рядом, да просвет между ними, в одиннадцать не помещаются.
//
// Облако у дождя, снега и грозы то же самое: разница между ними внизу, и
// разное облако сверху читалось бы как разная погода, а не разные осадки.
Item {
    id: ico

    // Код вида "04d" от OpenWeatherMap — день и ночь здесь не различаются:
    // луна вместо солнца на семи рядах превращается в тот же круг.
    property string code: ""
    property real size: 16
    property real gapRatio: 0.22
    property color color: "#ffffff"

    readonly property real dotSize: ico.size / (7 + 6 * ico.gapRatio)
    readonly property real gap: ico.dotSize * ico.gapRatio
    readonly property real pitch: ico.dotSize + ico.gap

    readonly property var shapes: ({
        "clear": ["0000001000000", "0000111110000", "0001111111000", "0111111111110",
                  "0001111111000", "0000111110000", "0000001000000"],
        "few":   ["0000000001110", "0000000011111", "0011100111110", "0111111111111",
                  "1111111111111", "1111111111111", "0111111111110"],
        "cloud": ["0000000011100", "0011100111110", "0111111111111", "1111111111111",
                  "1111111111111", "1111111111111", "0111111111110"],
        "rain":  ["0000000011100", "0011100111110", "0111111111111", "1111111111111",
                  "0111111111110", "0001001001000", "0010010010000"],
        "snow":  ["0000000011100", "0011100111110", "0111111111111", "1111111111111",
                  "0111111111110", "0001001001000", "0000100010000"],
        "storm": ["0000000011100", "0011100111110", "0111111111111", "1111111111111",
                  "0111111111110", "0000011100000", "0000110000000"],
        "mist":  ["0000000000000", "0001111111000", "0000000000000", "0011111111100",
                  "0000000000000", "0001111111000", "0000000000000"]
    })

    // Первые две цифры кода — сама погода, третья буква — время суток.
    readonly property string shapeName: {
        var k = String(ico.code).slice(0, 2);
        return k === "01" ? "clear"
             : k === "02" ? "few"
             : (k === "03" || k === "04") ? "cloud"
             : (k === "09" || k === "10") ? "rain"
             : k === "11" ? "storm"
             : k === "13" ? "snow"
             : k === "50" ? "mist"
             // Незнакомый код — облако: сервис завёл новый вид погоды, и
             // облако врёт меньше, чем пустое место или солнце.
             : "cloud";
    }

    readonly property var grid: ico.shapes[ico.shapeName]

    readonly property var cells: {
        var out = [];
        var g = ico.grid;
        if (!g) return out;
        for (var r = 0; r < g.length; r++)
            for (var c = 0; c < g[r].length; c++)
                if (g[r][c] === "1")
                    out.push({ x: c * ico.pitch, y: r * ico.pitch });
        return out;
    }

    implicitWidth: (ico.grid ? ico.grid[0].length : 13) * ico.pitch - ico.gap
    implicitHeight: 7 * ico.pitch - ico.gap

    Repeater {
        model: ico.cells

        Rectangle {
            required property var modelData
            x: modelData.x
            y: modelData.y
            width: ico.dotSize
            height: ico.dotSize
            radius: ico.dotSize / 2
            color: ico.color
        }
    }
}
