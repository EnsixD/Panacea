// Пользовательские переопределения конфигурации Niri для Panacea.
// Этот файл подключается в конце основного config.kdl через:
//   include "custom/custom.kdl"
//
// Любые ваши настройки здесь переживают обновление Panacea и не затираются.
//
// Примеры:
//
// 1. Настройка конкретного монитора:
// output "DP-1" {
//     mode "2560x1440@144.0"
//     scale 1.0
//     position x=1920 y=0
// }
//
// 2. Дополнительные горячие клавиши:
// binds {
//     Mod+B { spawn "firefox"; }
//     Mod+T { spawn "telegram-desktop"; }
// }
//
// 3. Дополнительные правила для окон:
// window-rule {
//     match app-id=r#"^steam$"#
//     open-floating true
// }
