{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // Оформление под пилюлю: подписи акцентом темы, значения белым,
  // разделители приглушённые. Строку с акцентом переписывает
  // hypr/scripts/switch_theme.sh — маркер ниже трогать не надо.
  "logo": {
    "source": "arch_small",
    "padding": { "top": 3, "left": 3, "right": 4 },
    // panacea:accent
    "color": { "1": "38;2;198;90;71", "2": "38;2;198;90;71" }
  },

  "display": {
    "separator": "  ",
    "color": {
      // panacea:accent
      "keys": "38;2;198;90;71",
      "title": "white",
      "output": "white"
    }
  },

  "modules": [
    "break",
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    { "type": "separator", "string": "─" },

    // то, что делает эту машину этой машиной
    { "type": "custom", "key": "󰏔 Shell   ", "format": "Panacea Island" },
    { "type": "wm",       "key": "󱂬 WM      " },
    { "type": "os",       "key": "󰣇 OS      ", "format": "{name} {arch}" },
    { "type": "kernel",   "key": "󰒋 Kernel  ", "format": "{release}" },
    { "type": "uptime",   "key": "󱎫 Uptime  " },
    { "type": "packages", "key": "󰏗 Packages", "format": "{pacman} pacman" },

    "break",

    { "type": "terminal", "key": "󰆍 Terminal", "format": "{pretty-name}" },
    { "type": "shell",    "key": "󰈺 CLI     ", "format": "{pretty-name} {version}" },
    { "type": "cpu",      "key": "󰻠 CPU     ", "format": "{name}" },
    { "type": "gpu",      "key": "󰢮 GPU     ", "format": "{name}" },
    { "type": "memory",   "key": "󰍛 Memory  " },
    { "type": "disk",     "key": "󰋊 Disk    ", "folders": "/" },
    { "type": "battery",  "key": "󰁹 Battery ", "format": "{capacity} ({status})" },

    "break",
    { "type": "separator", "string": "─" },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 1
    },
    "break"
  ]
}
